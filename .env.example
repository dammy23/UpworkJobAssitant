# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://assistant:assistant@localhost:5432/upwork_assistant

# API server (also serves the built web app)
PORT=4000

# Encrypts saved API keys and tokens. If left empty, one is generated into server/data/app-secret
# on first run. Keep it safe: saved keys can't be read without it.
APP_SECRET=

# Where uploaded resumes and videos are kept (relative to server/)
UPLOAD_DIR=./uploads

# Set to "off" to stop the background schedule (appliers then only run with "Check now")
SCHEDULER=on

# Address of the web app, used in Telegram links
WEB_BASE_URL=http://localhost:5173

# Upwork accounts, AI providers (Groq, Claude, OpenAI, Ollama) and Telegram are set up in the app's Settings page.
