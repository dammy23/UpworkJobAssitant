# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://assistant:assistant@localhost:5432/upwork_assistant

# API server
PORT=4000
UPLOAD_DIR=./uploads

# Where jobs come from: "fixtures" (sample jobs, no key needed) or "upwork" (official GraphQL API)
JOB_SOURCE=fixtures

# Upwork API (personal-use key from https://www.upwork.com/developer)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=

# LLM: Groq free tier (OpenAI-compatible). Leave GROQ_API_KEY empty to use the offline heuristic scorer.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback provider (OpenAI-compatible), e.g. OpenRouter free models
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base URL of the web UI, used in Telegram links
WEB_BASE_URL=http://localhost:5173
